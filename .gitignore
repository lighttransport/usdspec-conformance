# cache and other artifacts produced by Lean's Lake build tool
.lake/
.lake
build/
__pycache__/
*.pyc

# Transformed AOUSD grammar is generated for local verification, not distributed.
/verif/lean/UsdSpec/Usda/GeneratedRules.lean

# Pages site output: generated at deploy (or during local testing) by
# pages/build.mjs. Sources live in pages/src/ and the repo documents;
# pages/README.md is tracked documentation.
/pages/*.html
/pages/index.md
/pages/status.md
/pages/formalization.md
/pages/reflection.md
/pages/findings.md
/pages/verification.md
/pages/ledger.md
