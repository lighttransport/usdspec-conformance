<?xml version="1.0"?>
<!-- 1.39 document: open_pbr_surface with a nodegraph-fed base colour, an
     interface-driven coat roughness and authored OpenPBR defaults left alone. -->
<materialx version="1.39">
  <nodegraph name="NG_base">
    <input name="tint" type="color3" value="0.2, 0.4, 0.6" />
    <multiply name="scaled" type="color3">
      <input name="in1" type="color3" interfacename="tint" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <output name="color" type="color3" nodename="scaled" />
  </nodegraph>
  <open_pbr_surface name="SR_pbr" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_base" output="color" />
    <input name="specular_roughness" type="float" value="0.35" />
    <input name="coat_weight" type="float" value="1.0" />
    <input name="coat_roughness" type="float" value="0.15" />
  </open_pbr_surface>
  <surfacematerial name="M_pbr" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_pbr" />
  </surfacematerial>
</materialx>
